{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "pinDigests": true,
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "groupName": "container images"
    }
  ]
}
